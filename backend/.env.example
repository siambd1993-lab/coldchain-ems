###############################################################################
# ColdChain EMS — backend environment (copy to .env, then `php artisan key:generate`)
###############################################################################
APP_NAME="ColdChain EMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Store/compute in UTC; render to operators in Asia/Dhaka (see config/app.php).
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Asia/Dhaka
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_CURRENCY=BDT

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database (MySQL 8) -------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=coldchain
DB_USERNAME=coldchain
DB_PASSWORD=secret

# --- Cache / queue / session (Redis) -----------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log

# --- Filesystem / object storage (S3) ----------------------------------------
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- JWT auth (php-open-source-saver/jwt-auth) --------------------------------
JWT_SECRET=
JWT_ALGO=HS256
# access token TTL (minutes) and refresh TTL (minutes = 14 days)
JWT_TTL=15
JWT_REFRESH_TTL=20160

# --- IoT / MQTT ingestion -----------------------------------------------------
MQTT_HOST=emqx
MQTT_PORT=1883
MQTT_TLS=false
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=coldchain-ingest

# --- Messaging providers (Phase 1 stubs) -------------------------------------
SMS_DRIVER=log
WHATSAPP_DRIVER=log
MAIL_MAILER=log
